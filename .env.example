# Copia este archivo a .env.local y rellena los dos valores.
# .env.local está en el .gitignore: nunca se sube al repositorio.
#
# Los dos salen de Supabase → Project Settings → API
#
#   VITE_SUPABASE_URL       "Project URL"
#   VITE_SUPABASE_ANON_KEY  la clave "anon public"
#
# NO uses aquí la clave `service_role`: se salta todas las reglas de seguridad
# y en una app de navegador quedaría a la vista de cualquiera.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
