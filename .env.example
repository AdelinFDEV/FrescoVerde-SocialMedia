# Copia este archivo a .env.local y rellena los valores.
# .env.local está en el .gitignore: nunca se sube al repositorio.
#
# En Vercel las mismas variables van en Settings → Environment Variables, y
# después hay que volver a desplegar: Vite las mete dentro del JavaScript al
# construir, así que un despliegue que ya existe no las coge.


# --- Supabase -------------------------------------------------------------
# Salen de Supabase → Connect → Framework, o de Project Settings → API Keys.
#
# NO uses aquí la clave `service_role` / `secret`: se salta todas las reglas
# de seguridad y en una app de navegador quedaría a la vista de cualquiera.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# --- Contraseña de acceso -------------------------------------------------
# Huella SHA-256 de la contraseña, NO la contraseña. Se genera con:
#
#   npm run hash-password
#
# Si se deja vacío no se pide contraseña, que es lo cómodo en local.
#
# Ojo con qué protege esto: es una cortina para que quien llegue de casualidad
# al enlace no vea el panel. No protege los datos — la clave de Supabase viaja
# en la página y las políticas permiten leer sin sesión iniciada.

VITE_ACCESS_PASSWORD_HASH=
